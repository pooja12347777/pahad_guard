[auth]
# Any local URL works for development. Must exactly match one of the
# "Authorized redirect URIs" you add in Google Cloud Console.
redirect_uri = "http://localhost:8501/oauth2callback"

# A random secret Streamlit uses to encrypt the login cookie.
# Generate your own with:  python3 -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "replace-this-with-a-random-64-character-hex-string"

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
client_id = "your-client-id.apps.googleusercontent.com"
client_secret = "your-client-secret"

# Fixed value for Google — do not change.
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
